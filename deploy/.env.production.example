# Copy on your dedicated Ubuntu VM to /opt/wardrobeshare/.env (never commit real values)
# Generate secrets: openssl rand -hex 24
POSTGRES_PASSWORD=SET_LONG_RANDOM_HEX_PASSWORD
MONGO_ROOT_USERNAME=wardrobe_admin
MONGO_ROOT_PASSWORD=SET_ANOTHER_RANDOM_HEX_PASSWORD
WEB_IMAGE=ghcr.io/owner/repository-web:sha-REPLACE
SEED_DEMO=0
COOKIE_SECURE=1
# Add PUBLIC_ORIGIN after setting up HTTPS reverse proxy (future security requirement).
PUBLIC_ORIGIN=https://wardrobe.example.com
REQUIRE_BACKGROUND_AI=1
# Place u2netp.onnx in /opt/wardrobeshare/models/ before enabling production.
