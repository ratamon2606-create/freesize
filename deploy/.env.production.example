# VPS only. Copy to /opt/wardrobeshare/.env, chmod 600, never commit real secrets.
# Generate unique values with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_RANDOM_64_HEX_CHARS
MONGO_ROOT_USERNAME=wardrobe_admin
MONGO_ROOT_PASSWORD=REPLACE_ANOTHER_RANDOM_64_HEX_CHARS
# Do not expose this app to the world until DNS resolves to your VPS.
SITE_DOMAIN=closet.example.com
PUBLIC_ORIGIN=https://closet.example.com
# Immutable GHCR image built by CI. Do NOT use :latest.
WEB_IMAGE=ghcr.io/owner/repo-web@sha256:REPLACE_REAL_DIGEST
