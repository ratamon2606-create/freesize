# Change before deploying to a real server. Demo credentials are public examples.
POSTGRES_PASSWORD=change_this_long_random_password
WEB_PORT=3000
SEED_DEMO=1
COOKIE_SECURE=0
# Keep optional U²-NetP weights in ./models/u2netp.onnx (not in Git).
LOCAL_AI_MODELS_DIR=./models
# Set 1 only when local model exists; required for public production.
REQUIRE_BACKGROUND_AI=0
